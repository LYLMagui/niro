<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="springAppName" source="spring.application.name" defaultValue="niro-backend"/>
    <springProperty scope="context" name="consoleCharset" source="logging.charset.console" defaultValue="UTF-8"/>
    <!-- 定义日志路径，默认指向 /var/log/niro (Docker环境) -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="/var/log/niro"/>

    <!-- 控制台日志 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
            <!-- Windows 下 CMD 默认 GBK，强制 UTF-8 会导致乱码。移除 charset 设置使其跟随系统默认 -->
        </encoder>
    </appender>

    <!-- JSON 文件日志 (Global) -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/backend.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/backend.%d{yyyy-MM-dd_HH}.%i.json.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <thread>thread</thread>
                <logger>class</logger>
                <message>message</message>
            </fieldNames>
            <!-- 显式包含 traceId，如果 MDC 中有的话 -->
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <!-- 全环境输出 Console 和 JSON -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>

</configuration>
