<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="springAppName" source="spring.application.name" defaultValue="niro-backend"/>
    <springProperty scope="context" name="consoleCharset" source="logging.charset.console" defaultValue="UTF-8"/>
    <!-- 定义日志路径，默认指向 /var/log/niro (Docker环境) -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="/var/log/niro"/>

    <!-- 控制台日志 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
            <!-- Windows 下 CMD 默认 GBK，强制 UTF-8 会导致乱码。移除 charset 设置使其跟随系统默认 -->
        </encoder>
    </appender>

    <!-- 普通文件日志：按日期目录存放，按小时轮转 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd,aux}/backend.%d{HH}.log</fileNamePattern>
            <maxHistory>72</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{39} [%X{traceId}] - %msg%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
            <charset>${consoleCharset}</charset>
        </encoder>
    </appender>

    <!-- SDK 文件日志：后端日志目录下 sdk 子目录，按日期轮转 -->
    <appender name="SDK_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/sdk/sdk.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>3</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{39} [%X{traceId}] [%X{c5TraceId}] - %msg%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
            <charset>${consoleCharset}</charset>
        </encoder>
    </appender>

    <logger name="com.niro.sdk" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SDK_FILE"/>
    </logger>

    <!-- 全环境输出 Console 和 FILE -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
