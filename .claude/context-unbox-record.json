{
  "project": {
    "name": "niro-client",
    "path": "E:\\CodeSpace\\PYTHON\\niro\\niro-client",
    "framework": "Vue 3 + TypeScript + TDesign + Pinia"
  },
  "task": "创建开箱记录页面 UnboxRecord.vue",
  "requirements": {
    "pageType": "新建独立页面",
    "dataStorage": "本地存储（localStorage）",
    "discountSetting": "每条记录单独输入 + 全局批量设置"
  },
  "tableColumns": [
    { "name": "箱子", "key": "boxName", "type": "string", "input": "user" },
    { "name": "购入价", "key": "boxPrice", "type": "number", "input": "user" },
    { "name": "截图", "key": "screenshot", "type": "string", "input": "user" },
    { "name": "枪", "key": "weaponName", "type": "string", "input": "user" },
    { "name": "磨损", "key": "wear", "type": "number", "input": "user" },
    { "name": "属性", "key": "property", "type": "string", "input": "user", "options": ["普通", "ST", "FT", "WW", "BS"] },
    { "name": "steam购入价", "key": "steamPrice", "type": "number", "input": "user" },
    { "name": "实际购入价", "key": "actualPrice", "type": "number", "compute": "steamPrice * discount" },
    { "name": "平台价", "key": "platformPrice", "type": "number", "input": "user" },
    { "name": "折扣", "key": "discount", "type": "number", "input": "user", "default": 0.72 },
    { "name": "预估利润", "key": "estimatedProfit", "type": "number", "compute": "steamPrice - platformPrice" },
    { "name": "购买状态", "key": "purchaseStatus", "type": "string", "input": "select", "options": [{"label": "✅ 已购买", "value": "purchased"}, {"label": "🟠 未购买", "value": "not_purchased"}, {"label": "❌ 放弃购买", "value": "abandoned"}] },
    { "name": "利润率", "key": "profitRate", "type": "number", "compute": "(estimatedProfit / actualPrice) * 100" },
    { "name": "实际出售价", "key": "actualSellPrice", "type": "number", "input": "user" },
    { "name": "实际利润", "key": "actualProfit", "type": "number", "compute": "actualSellPrice - actualPrice" }
  ],
  "summaryData": [
    { "name": "Steam 购入总价", "key": "totalSteamPrice", "compute": "sum(steamPrice)" },
    { "name": "预估总利润", "key": "totalEstimatedProfit", "compute": "sum(estimatedProfit)" }
  ],
  "uiRequirements": {
    "summaryPosition": "右上角卡片展示",
    "globalDiscount": "支持批量设置折扣",
    "addRecord": "支持新增记录",
    "editRecord": "支持编辑记录",
    "deleteRecord": "支持删除记录"
  },
  "existingFiles": {
    "storeExample": "niro-client/src/store/task.ts",
    "pageExample": "niro-client/src/views/ProfitStats.vue",
    "typeExample": "niro-client/src/types/profit.ts"
  },
  "designGuidelines": {
    "avoidEmoji": "禁止使用Emoji作为图标，使用SVG图标",
    "touchTarget": "触摸目标至少44x44px",
    "contrast": "颜色对比度符合标准",
    "spacing": "元素间隔合理，边界清晰"
  }
}
