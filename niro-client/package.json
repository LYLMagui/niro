{
  "name": "niro-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite dev --mode production",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:eslint": "eslint --cache \"src/**/*.{vue,ts}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --fix",
    "lint:lint-staged": "lint-staged",
    "lint": "run-p lint:eslint lint:prettier lint:stylelint",
    "prepare": "husky",
    "commit": "git-cz",
    "gen-icons": "node src/scripts/gen-tailwind-icons.mjs"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@iconify/iconify": "^3.1.1",
    "@iconify/json": "^2.2.343",
    "@iconify/tailwind": "^1.2.0",
    "@iconify/tailwind4": "^1.0.6",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.1.7",
    "@vueuse/core": "^13.2.0",
    "axios": "^1.10.0",
    "crypto-js": "^4.2.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "qs": "^6.14.0",
    "tailwindcss": "^4.1.10",
    "tdesign-icons-vue-next": "^0.3.0",
    "tdesign-vue-next": "^1.9.0",
    "vue": "^3.5.14",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.26.0",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.18",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "commitizen": "^4.3.1",
    "commitlint": "^20.2.0",
    "cz-git": "^1.12.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^10.1.0",
    "fs-extra": "^11.3.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.3",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "stylelint": "^16.19.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.0.0",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-recommended-scss": "^16.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-prettier": "^5.0.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.3.2",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  }
}
