# 数据库账号
NEW_API_DB_USER=root
# 数据库密码（生产环境务必修改）
NEW_API_DB_PASSWORD=change_this_password
# 数据库名
NEW_API_DB_NAME=new-api
# 多机部署时建议设置固定随机字符串；单机可先留空
NEW_API_SESSION_SECRET=

# PostgreSQL 低内存启动参数
# 最大连接数；值越小，整体内存占用通常越低
POSTGRES_MAX_CONNECTIONS=50
# PostgreSQL 共享缓冲区；轻量部署可先从 128MB 起步
POSTGRES_SHARED_BUFFERS=128MB
# 单次排序/哈希等操作的工作内存
POSTGRES_WORK_MEM=2MB
# VACUUM / CREATE INDEX 等维护操作使用的内存
POSTGRES_MAINTENANCE_WORK_MEM=32MB
# 会话级临时缓冲区
POSTGRES_TEMP_BUFFERS=4MB
