{
  "name": "buff-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite dev --mode production",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint:eslint": "eslint --cache \"src/**/*.{vue,ts}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,css,scss,vue,html,md}\"",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "axios": "^1.6.0",
    "pinia": "^2.1.0",
    "tdesign-icons-vue-next": "^0.3.0",
    "tdesign-vue-next": "^1.9.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.4.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.8"
  }
}
